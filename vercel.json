{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "installCommand": "npm install --include=dev",
    "framework": "vite",
    "rootDirectory": "client",
    "rewrites": [
        {
            "source": "/uploads/(.*)",
            "destination": "/uploads/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}